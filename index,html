<script>
(function () {
  'use strict';

  /* ---------- переключение изданий и темы ---------- */

  var buttons  = Array.prototype.slice.call(document.querySelectorAll('.edition-btn'));
  var sections = Array.prototype.slice.call(document.querySelectorAll('.edition'));
  var label    = document.getElementById('editionLabel');

  var META = {
    humans:   { theme: 'light', label: 'Издание для людей' },
    vampires: { theme: 'dark',  label: 'Оттиск для «Альбиона»' }
  };

  function activate(name, updateHash) {
    var meta = META[name];
    if (!meta) return;

    buttons.forEach(function (b) {
      var on = b.dataset.edition === name;
      b.classList.toggle('active', on);
      b.setAttribute('aria-selected', on ? 'true' : 'false');
      b.tabIndex = on ? 0 : -1;
    });
    sections.forEach(function (s) { s.classList.toggle('active', s.id === name); });

    document.documentElement.dataset.theme = meta.theme;
    label.textContent = meta.label;

    if (updateHash !== false) history.replaceState(null, '', '#' + name);
  }

  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (!btn.classList.contains('active')) activate(btn.dataset.edition);
    });
    btn.addEventListener('keydown', function (e) {
      var i = buttons.indexOf(btn), next = null;
      if (e.key === 'ArrowRight') next = buttons[(i + 1) % buttons.length];
      if (e.key === 'ArrowLeft')  next = buttons[(i - 1 + buttons.length) % buttons.length];
      if (next) { e.preventDefault(); next.focus(); activate(next.dataset.edition); }
    });
  });

  var startId = location.hash.slice(1);
  if (META[startId]) activate(startId, false);

  window.addEventListener('hashchange', function () {
    var id = location.hash.slice(1);
    if (META[id]) activate(id, false);
  });

  /* ---------- кнопка «наверх» ---------- */

  var toTop = document.getElementById('toTop');
  var ticking = false;

  function frame() {
    ticking = false;
    toTop.classList.toggle('visible', window.scrollY > 400);
  }
  window.addEventListener('scroll', function () {
    if (!ticking) { ticking = true; requestAnimationFrame(frame); }
  }, { passive: true });

  toTop.addEventListener('click', function () {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  frame();
})();
</script>

